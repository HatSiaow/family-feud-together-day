PORT=3000
BASE_URL=http://localhost:3000
ADMIN_TOKEN=choose-a-passcode

# DeepSeek API key. If unset, the server falls back to a naive local
# clustering heuristic for dev/testing only — set this before the real event.
DEEPSEEK_API_KEY=

# Redaction terms, comma-separated, one env var per round (round-1, round-2, round-3).
# These contain the real client name/aliases — never commit actual values.
REDACT_ROUND_1=CBA,Commonwealth Bank,Commbank
REDACT_ROUND_2=
REDACT_ROUND_3=
